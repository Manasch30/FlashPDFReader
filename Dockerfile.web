FROM python:3.11-slim

# Install X11 virtual frame buffer (xvfb), x11vnc, noVNC, and Qt GUI dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    openbox \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libegl1 \
    libdbus-1-3 \
    libfontconfig1 \
    libxkbcommon-x11-0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-xinerama0 \
    libxcb-xfixes0 \
    libpulse0 \
    pulseaudio \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PYTHONPATH=/app/src
EXPOSE 6080

# Start Xvfb virtual display, Openbox window manager, x11vnc, noVNC web server, and FlashPDF Reader
CMD ["sh", "-c", "Xvfb :99 -screen 0 1280x800x24 & openbox & x11vnc -display :99 -forever -shared -nopw & websockify --web /usr/share/novnc 6080 localhost:5900 & DISPLAY=:99 python -m flashpdf.app"]
